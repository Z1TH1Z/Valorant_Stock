generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  predictions  Prediction[]
}

model Team {
  id                String                   @id @default(uuid())
  name              String
  region            String
  logoUrl           String?
  vlrTeamUrl        String?
  createdAt         DateTime                 @default(now())
  players           Player[]
  performanceHistory TeamPerformanceHistory[]
}

model Player {
  id          String   @id @default(uuid())
  name        String
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  country     String?
  rating      Float?
  acs         Float?
  kdRatio     Float?
  adr         Float?
  kast        Float?
  hsPercent   Float?
  fkPerRound  Float?
  fdPerRound  Float?
  updatedAt   DateTime @updatedAt
}

model Match {
  id           String   @id @default(uuid())
  teamOneId    String
  teamTwoId    String
  teamOneScore Int
  teamTwoScore Int
  region       String
  eventName    String
  matchDate    DateTime
  status       String
  maps         Map[]
  predictions  Prediction[]
}

model Map {
  id           String @id @default(uuid())
  matchId      String
  match        Match  @relation(fields: [matchId], references: [id])
  mapName      String
  teamOneScore Int
  teamTwoScore Int
}

model TeamPerformanceHistory {
  id               String   @id @default(uuid())
  teamId           String
  team             Team     @relation(fields: [teamId], references: [id])
  performanceScore Float
  weekStartDate    DateTime
  weekEndDate      DateTime
  createdAt        DateTime @default(now())
}

model Prediction {
  id                     String            @id @default(uuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id])
  matchId                String
  match                  Match             @relation(fields: [matchId], references: [id])
  predictedWinnerTeamId  String
  predictedSeriesScore   String
  createdAt              DateTime          @default(now())
  maps                   PredictionMap[]
  score                  PredictionScore?
}

model PredictionMap {
  id                String     @id @default(uuid())
  predictionId      String
  prediction        Prediction @relation(fields: [predictionId], references: [id])
  mapNumber         Int
  predictedMinScore Int
  predictedMaxScore Int
}

model PredictionScore {
  id           String     @id @default(uuid())
  predictionId String     @unique
  prediction   Prediction @relation(fields: [predictionId], references: [id])
  scoreAwarded Int
  createdAt    DateTime   @default(now())
}
